name: dockercompose18156756358006368797
services:
  bookify-db:
    container_name: Bookify.Db
    environment:
      POSTGRES_DB: bookify
      POSTGRES_PASSWORD: postgres
      POSTGRES_USER: postgres
    image: postgres:latest
    networks:
      default: null
    ports:
    - mode: ingress
      target: 5432
      published: "5432"
      protocol: tcp
    volumes:
    - type: bind
      source: C:\Users\bullet\source\repos\Leodinm\bookify\.containers\database
      target: /var/lib/postgresql/data
      bind:
        create_host_path: true
  bookify.api:
    build:
      context: C:\Users\bullet\source\repos\Leodinm\bookify
      dockerfile: src/Bookify.Api/Dockerfile
    container_name: Bookify.Api
    depends_on:
      bookify-db:
        condition: service_started
    environment:
      ASPNETCORE_ENVIRONMENT: Development
      ASPNETCORE_HTTP_PORTS: "5000"
      ASPNETCORE_HTTPS_PORTS: "5001"
    image: bookifyapi
    networks:
      default: null
    ports:
    - mode: ingress
      target: 5000
      published: "5000"
      protocol: tcp
    - mode: ingress
      target: 5001
      published: "5001"
      protocol: tcp
    volumes:
    - type: bind
      source: C:\Users\bullet\AppData\Roaming/Microsoft/UserSecrets
      target: /root/.microsoft/usersecrets
      read_only: true
      bind:
        create_host_path: true
    - type: bind
      source: C:\Users\bullet\AppData\Roaming/ASP.NET/Https
      target: /root/.aspnet/https
      read_only: true
      bind:
        create_host_path: true
networks:
  default:
    name: dockercompose18156756358006368797_default