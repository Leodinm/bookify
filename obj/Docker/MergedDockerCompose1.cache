services:
  bookify-db:
    container_name: Bookify.Db
    environment:
      POSTGRES_DB: bookify
      POSTGRES_PASSWORD: postgres
      POSTGRES_USER: postgres
    image: postgres:16
    ports:
    - published: 5433
      target: 5432
    volumes:
    - C:\Users\bullet\source\repos\Leodinm\bookify\.containers\database:/var/lib/postgresql/data:rw
  bookify.api:
    build:
      context: C:\Users\bullet\source\repos\Leodinm\bookify
      dockerfile: src/Bookify.Api/Dockerfile
    container_name: Bookify.Api
    depends_on:
      bookify-db:
        condition: service_healthy
    environment:
      ASPNETCORE_ENVIRONMENT: Development
      ASPNETCORE_HTTPS_PORTS: '5001'
      ASPNETCORE_HTTP_PORTS: '5000'
      ConnectionStrings__Database: Host=bookify-db;Port=5432;Database=bookify;Username=postgres;Password=postgres;
    image: bookifyapi
    ports:
    - published: 5000
      target: 5000
    - published: 5001
      target: 5001
    volumes:
    - C:\Users\bullet\AppData\Roaming\ASP.NET\Https:/root/.aspnet/https:ro
    - C:\Users\bullet\AppData\Roaming\Microsoft\UserSecrets:/root/.microsoft/usersecrets:ro
version: '3.4'